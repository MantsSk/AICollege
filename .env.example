# App
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=AI College
BASE_URL=https://your-domain.example
DEBUG=false
ALLOWED_HOSTS=your-domain.example,www.your-domain.example
SECURE_SSL_REDIRECT=false

# Database
POSTGRES_USER=aicollege
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=aicollege
DATABASE_URL=postgresql+psycopg2://aicollege:change-me-to-a-long-random-password@db:5432/aicollege

# LiteLLM / AI Mentor
# Examples: gemini/gemini-1.5-flash, gpt-4o-mini, claude-haiku-4-5-20251001
AI_MODEL=gemini/gemini-1.5-flash
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=1024
# Provider API keys (set whichever your AI_MODEL needs)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Free tier limits
FREE_DAILY_AI_MESSAGES=5
PAID_DAILY_AI_MESSAGES=200
FREE_LESSONS_PER_COURSE=2

# Stripe
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
SUBSCRIPTION_PRICE_EUR=20
